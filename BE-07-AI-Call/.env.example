# LLM Provider Configuration
# Options for LLM_BASE_URL:
#   Ollama:     http://localhost:11434/v1
#   OpenRouter: https://openrouter.ai/api/v1
LLM_BASE_URL=http://localhost:11434/v1

# Key (for Ollama use 'ollama', for OpenRouter use your sk-or-v1-... key)
LLM_API_KEY=ollama

# Model name (e.g. llama3.2:1b, llama3.2:3b, gemma3:1b, openrouter/free)
LLM_MODEL=llama3.2:1b

# Application Flags
LLM_STUB=0
LLM_ENABLED=true
